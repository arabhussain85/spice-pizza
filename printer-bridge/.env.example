# Spice Pizza — Printer Bridge Environment Variables
# Copy to .env and fill in your values.

# Port the bridge listens on (default: 4000)
PORT=4000

# Printer mode:
#   stub        — acknowledge only, no real printing (default/safe)
#   pdf_spooler — print PDF to a Windows printer (requires printerName in job)
#   network     — ESC/POS over LAN (thermal printer, future)
#   usb         — ESC/POS direct USB (thermal printer, future)
PRINTER_MODE=pdf_spooler

# Optional: default printer name for pdf_spooler mode
# If not set, the web UI will prompt you to select one.
# Example: Black Copper 80
# DEFAULT_PRINTER_NAME=Black Copper 80
